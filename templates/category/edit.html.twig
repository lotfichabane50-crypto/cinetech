{% extends 'base.html.twig' %}

{% block title %}Modifier {{ category.name }} - CinéTech{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-md border border-slate-200">
        <div class="mb-6">
            <a href="{{ path('app_category_index') }}" class="text-indigo-600 hover:underline text-sm font-medium">
                ← Retour aux catégories
            </a>
            <h1 class="text-3xl font-bold text-slate-900 mt-2">Modifier « {{ category.name }} »</h1>
        </div>

        {{ include('category/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

        <div class="mt-6 pt-6 border-t border-slate-200">
            {{ include('category/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
