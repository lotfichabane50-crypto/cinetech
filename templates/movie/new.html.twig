{% extends 'base.html.twig' %}

{% block title %}Ajouter un film - CinéTech{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-md border border-slate-200">
        <div class="mb-6">
            <a href="{{ path('app_movie_index') }}" class="text-indigo-600 hover:underline text-sm font-medium">
                ← Retour au catalogue
            </a>
            <h1 class="text-3xl font-bold text-slate-900 mt-2">Ajouter un film</h1>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-4'}}) }}
            {{ form_widget(form) }}

            <div class="pt-4">
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 px-4 rounded-lg transition">
                    Enregistrer le film
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}