{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }} - CinéTech{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('app_movie_index') }}" class="text-indigo-600 hover:underline font-medium">
            ← Retour au catalogue
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-slate-200 max-w-4xl md:flex">
        {% if movie.poster %}
            <img src="{{ movie.poster }}" alt="{{ movie.title }}" class="w-full md:w-72 object-cover">
        {% endif %}

        <div class="p-8 flex-grow">
            <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="text-xs font-bold tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded">
                    {{ movie.category.name | upper }}
                </span>
                <span class="text-sm text-slate-500">
                    Sortie le {{ movie.releaseDate | date('d/m/Y') }}
                </span>
                <span class="text-sm text-slate-500">
                    • {{ movie.duration }} min
                </span>
                <span class="text-sm font-semibold text-amber-600">
                    ★ {{ movie.rating ?? 'N/A' }} / 5
                </span>

                {% if movie.rating and movie.rating >= 4.5 %}
                    <span class="text-xs font-semibold bg-rose-100 text-rose-700 px-3 py-1 rounded-full">
                        ❤️ Coup de cœur
                    </span>
                {% endif %}
            </div>

            <h1 class="text-4xl font-extrabold text-slate-900 mb-6">
                {{ movie.title }}
            </h1>

            <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">
                Synopsis
            </h2>
            <p class="text-slate-700 text-lg leading-relaxed">
                {{ movie.synopsis }}
            </p>
        </div>
    </div>
{% endblock %}