{% extends 'base.html.twig' %}

{% block title %}Catalogue - CinéTech{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-slate-900">
            Catalogue ({{ movies | length }} films)
        </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for movie in movies %}
            <div class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col justify-between border border-slate-200">
                <div>
                    {% if movie.poster %}
                        <img src="{{ movie.poster }}" alt="{{ movie.title }}" class="w-full h-48 object-cover">
                    {% endif %}

                    <div class="p-6">
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-xs font-bold tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded">
                                {{ movie.category.name | upper }}
                            </span>

                            {% if movie.rating and movie.rating >= 4.5 %}
                                <span class="text-xs font-semibold bg-rose-100 text-rose-700 px-2.5 py-1 rounded-full">
                                    ❤️ Coup de cœur
                                </span>
                            {% endif %}
                        </div>

                        <h2 class="text-xl font-bold text-slate-900 mb-1">
                            {{ movie.title }}
                        </h2>
                        <p class="text-sm text-slate-500 mb-4">
                            Sortie en {{ movie.releaseDate | date('Y') }} • {{ movie.duration }} min • Note : <strong>{{ movie.rating ?? 'N/A' }}/5</strong>
                        </p>
                        <p class="text-slate-600 text-sm">
                            {{ (movie.synopsis ?? '') | slice(0, 100) ~ '...' }}
                        </p>
                    </div>
                </div>

                <div class="px-6 pb-6">
                    <a href="{{ path('app_movie_show', {id: movie.id}) }}"
                       class="block text-center bg-slate-900 hover:bg-slate-800 text-white font-medium py-2.5 px-4 rounded-lg transition">
                        Voir les détails
                    </a>
                </div>
            </div>
        {% else %}
            <p class="text-slate-500">Aucun film disponible dans le catalogue.</p>
        {% endfor %}
    </div>
{% endblock %}