{% extends 'base.html.twig' %}

{% block title %}Modifier {{ movie.title }} - CinéTech{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-md border border-slate-200">
        <div class="mb-6">
            <a href="{{ path('app_movie_show', {id: movie.id}) }}" class="text-indigo-600 hover:underline text-sm font-medium">
                ← Retour à la fiche du film
            </a>
            <h1 class="text-3xl font-bold text-slate-900 mt-2">Modifier « {{ movie.title }} »</h1>
        </div>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'space-y-4'}}) }}
            {{ form_widget(form) }}

            <div class="pt-4">
                <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold py-3 px-4 rounded-lg transition">
                    Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}