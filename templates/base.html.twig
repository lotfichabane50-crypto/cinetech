<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CinéTech{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col">

    {% include '_partials/_navbar.html.twig' %}

    <main class="max-w-6xl mx-auto px-4 flex-grow w-full">
    
    {% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="p-4 mb-6 rounded-lg font-medium border {{ label == 'warning' ? 'bg-amber-100 text-amber-900 border-amber-300' : 'bg-emerald-100 text-emerald-900 border-emerald-300' }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="bg-slate-900 text-slate-400 text-center py-4 mt-12 text-sm">
        CinéTech - Projet Fil Rouge Symfony 8
    </footer>

</body>
</html>